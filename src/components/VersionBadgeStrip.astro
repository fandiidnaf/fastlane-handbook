---
import versionData from '../data/fastlane-version.json';

const {
  fastlane_version,
  min_ruby_version,
  recommended_ruby_version,
  active_actions,
  total_actions,
  upstream_repo,
  rubygems_url,
} = versionData;

const releaseUrl = `${upstream_repo}/releases/tag/${fastlane_version}`;
---

<div class="version-badge-strip">
  <a
    href={releaseUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="badge-pill badge-primary"
    title={`Fastlane version ${fastlane_version} on GitHub`}
  >
    <span class="badge-dot pulse"></span>
    <span class="badge-label">Fastlane</span>
    <span class="badge-value">v{fastlane_version}</span>
  </a>

  <div
    class="badge-pill badge-ruby"
    title="Minimum required Ruby version is 3.2.0. Ruby 3.3+ is officially recommended."
  >
    <span class="badge-icon">💎</span>
    <span class="badge-label">Ruby:</span>
    <span class="badge-value">{min_ruby_version}</span>
    <span class="badge-subtext">(Rec. 3.3+)</span>
  </div>

  <a
    href="/fastlane-handbook/actions/upload_to_play_store/"
    class="badge-pill badge-neutral"
    title="Introspected directly from Fastlane Gem AST"
  >
    <span class="badge-icon">⚡</span>
    <span class="badge-label">Actions:</span>
    <span class="badge-value">{active_actions} Active</span>
    <span class="badge-subtext">({total_actions} Total)</span>
  </a>

  <a
    href={rubygems_url}
    target="_blank"
    rel="noopener noreferrer"
    class="badge-pill badge-rubygems"
    title="View Fastlane on RubyGems"
  >
    <span class="badge-label">RubyGems:</span>
    <span class="badge-value">stable</span>
  </a>
</div>

<style>
  .version-badge-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin: 1.25rem 0 2rem 0;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    line-height: 1.2;
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .badge-pill:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  .badge-primary {
    background: color-mix(in srgb, var(--sl-color-accent) 15%, transparent);
    color: var(--sl-color-text-accent);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 40%, transparent);
    font-weight: 600;
  }

  .badge-ruby {
    background: color-mix(in srgb, #e11d48 12%, transparent);
    color: color-mix(in srgb, #f43f5e 90%, var(--sl-color-white));
    border: 1px solid color-mix(in srgb, #e11d48 35%, transparent);
  }

  .badge-neutral {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-4);
  }

  .badge-rubygems {
    background: color-mix(in srgb, #d97706 12%, transparent);
    color: color-mix(in srgb, #f59e0b 90%, var(--sl-color-white));
    border: 1px solid color-mix(in srgb, #d97706 35%, transparent);
  }

  .badge-label {
    opacity: 0.85;
    font-weight: 500;
  }

  .badge-value {
    font-weight: 600;
  }

  .badge-subtext {
    font-size: 0.72rem;
    opacity: 0.75;
  }

  .badge-icon {
    font-size: 0.85rem;
  }

  .badge-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: #10b981;
    display: inline-block;
  }

  .pulse {
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulse-green 2s infinite;
  }

  @keyframes pulse-green {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 5px rgba(16, 185, 129, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
    }
  }

  @media (max-width: 640px) {
    .version-badge-strip {
      padding: 0.625rem;
      gap: 0.5rem;
    }
    .badge-pill {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
    }
  }
</style>
