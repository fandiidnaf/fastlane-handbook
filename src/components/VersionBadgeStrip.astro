---
import versionData from '../data/fastlane-version.json';

const {
  fastlane_version,
  min_ruby_version,
  recommended_ruby_version,
  active_actions,
  total_actions,
  upstream_repo,
  rubygems_url,
} = versionData;

const releaseUrl = `${upstream_repo}/releases/tag/${fastlane_version}`;
---

<div class="version-badge-strip">
  <!-- Fastlane Official Badge -->
  <a
    href={releaseUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="badge-pill badge-fastlane"
    title={`Fastlane version ${fastlane_version} on GitHub`}
  >
    <svg
      class="badge-icon-svg fastlane-logo"
      viewBox="0 0 24 24"
      width="15"
      height="15"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M8.144 19.182a1.445 1.445 0 00-1.237-.868l-1.615-4.976-.37-1.135c-.017.01-.112.052-.13.06-.008.01-.025.01-.033.018a.366.366 0 00-.07.037.472.472 0 01-.102.043c-.043.016-.078.034-.12.042-.035.01-.07.027-.104.036-.04.01-.083.025-.126.034-.034.01-.068.017-.103.026a.584.584 0 01-.137.017c-.035.01-.07.01-.103.017-.028 0-.054 0-.08.01h-.16c-.052 0-.095 0-.146-.01-.035 0-.07 0-.095-.01l-.165-.025c-.026-.01-.052-.01-.086-.017a2.456 2.456 0 01-.25-.06 2.498 2.498 0 01-1.633-3.137C1.7 7.97 3.102 7.23 4.417 7.65l.344-1.1A3.673 3.673 0 00.167 8.94a3.674 3.674 0 002.39 4.59 3.877 3.877 0 001.624.128l1.634 5.035a1.432 1.432 0 00-.232.267 1.47 1.47 0 00.387 2.053 1.47 1.47 0 002.2-.662 1.572 1.572 0 00-.03-1.167zM11.901.412a3.656 3.656 0 00-3.62 3.697c.01.54.147 1.09.38 1.58L4.381 8.8a1.468 1.468 0 00-.327-.138 1.47 1.47 0 00-1.83.997c-.233.78.214 1.596.996 1.83.103.032.207.05.31.05.404.025.8-.11 1.09-.38.2-.18.354-.4.43-.678a1.44 1.44 0 00.018-.764l4.237-3.08.962-.702c-.017-.018-.077-.086-.094-.103l-.026-.026c-.017-.018-.035-.036-.052-.06a.46.46 0 01-.07-.087 1.952 1.952 0 00-.076-.103c-.026-.026-.043-.06-.07-.086a1.027 1.027 0 01-.068-.11.56.56 0 00-.06-.096.746.746 0 01-.06-.12c-.017-.034-.034-.06-.043-.095l-.026-.07c-.006-.017-.014-.042-.023-.06-.01-.034-.025-.07-.034-.094-.016-.044-.025-.096-.042-.147l-.025-.096c-.01-.05-.017-.11-.026-.163 0-.025-.01-.05-.018-.085a2.269 2.269 0 01-.017-.26 2.502 2.502 0 012.475-2.526 2.502 2.502 0 012.526 2.475l1.152-.01C15.576 2.01 13.92.386 11.9.41zm11.908 8.664a3.664 3.664 0 00-4.632-2.303 3.803 3.803 0 00-1.385.851l-4.28-3.109c.026-.113.034-.233.034-.354a1.483 1.483 0 00-1.512-1.435 1.483 1.483 0 00-1.436 1.513 1.47 1.47 0 00.744 1.23c.232.128.5.205.782.197.267-.01.525-.086.73-.224l4.239 3.077.962.705.07-.12c.008-.008.008-.025.016-.034.008-.027.025-.044.034-.07.017-.034.034-.06.05-.094a.46.46 0 00.07-.112l.06-.085c.026-.035.052-.07.086-.104.026-.026.043-.05.07-.086l.094-.095.077-.078c.018-.017.035-.034.06-.05.018-.018.036-.027.053-.044a.282.282 0 01.086-.06c.04-.026.084-.052.12-.078a.528.528 0 01.084-.05c.052-.027.094-.053.146-.08.026-.008.052-.025.077-.033a2.51 2.51 0 013.412 1.477 2.507 2.507 0 01-1.572 3.17l.37 1.09c1.9-.627 2.93-2.7 2.294-4.615zm-2.166.62a1.474 1.474 0 00-1.881-.895 1.532 1.532 0 00-.284.14c-.344.214-.584.56-.662.945-.05.258-.043.533.052.8.094.257.24.463.438.627l-1.616 4.976-.37 1.134c.018 0 .112.026.138.026.017 0 .026 0 .043.01.028.008.054.008.08.017.035.01.07.017.104.025.043.01.086.026.13.035.033.01.068.017.102.034l.12.05c.035.018.07.027.103.044.04.017.076.043.12.06.033.017.06.034.093.052.026.01.043.025.06.043.018.01.035.024.052.033.026.018.06.035.086.06a.58.58 0 01.113.096c.025.016.05.042.077.06.043.033.077.076.12.12.02.016.043.034.06.06.06.06.11.13.164.197a2.505 2.505 0 01-.516 3.497 2.507 2.507 0 01-3.5-.515l-.927.686c1.205 1.616 3.5 1.96 5.116.757 1.615-1.203 1.96-3.497.756-5.112a3.82 3.82 0 00-1.237-1.058l1.632-5.036a1.479 1.479 0 001.238-1.968zM18.2 18.905a1.446 1.446 0 00-1.315-.558 1.38 1.38 0 00-.748.3c-.215.163-.37.378-.465.61H9.243c0 .017.01.12.02.137 0 .018 0 .026.01.043 0 .026.01.052.01.078 0 .034.007.07.007.112 0 .043 0 .086.01.128v.112c0 .043-.01.086-.01.13 0 .034-.01.068-.01.11-.01.044-.02.087-.02.138-.007.035-.007.07-.015.103-.01.025-.01.05-.017.08-.01.014-.01.04-.018.06-.01.03-.017.066-.026.1-.017.043-.034.095-.052.14-.01.032-.025.06-.034.092a2.771 2.771 0 01-.077.146c-.016.025-.024.05-.033.077a2.132 2.132 0 01-.138.215 2.504 2.504 0 01-3.49.583 2.501 2.501 0 01-.585-3.489l-.937-.67a3.658 3.658 0 00.86 5.096 3.656 3.656 0 005.095-.86c.318-.445.524-.97.628-1.502h5.294a1.479 1.479 0 002.252.567c.61-.508.73-1.436.232-2.08z"/>
    </svg>
    <span class="badge-label">Fastlane</span>
    <span class="badge-value">v{fastlane_version}</span>
  </a>

  <!-- Official Ruby Badge -->
  <div
    class="badge-pill badge-ruby"
    title="Minimum required Ruby version is 3.2.0. Ruby 3.3+ is officially recommended."
  >
    <svg
      class="badge-icon-svg ruby-logo"
      viewBox="0 0 24 24"
      width="15"
      height="15"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M20.156.083c3.033.525 3.893 2.598 3.829 4.77L24 4.822 22.635 22.71 4.89 23.926h.016C3.433 23.864.15 23.729 0 19.139l1.645-3 2.819 6.586.503 1.172 2.805-9.144-.03.007.016-.03 9.255 2.956-1.396-5.431-.99-3.9 8.82-.569-.615-.51L16.5 2.114 20.159.073l-.003.01zM0 19.089zM5.13 5.073c3.561-3.533 8.157-5.621 9.922-3.84 1.762 1.777-.105 6.105-3.673 9.636-3.563 3.532-8.103 5.734-9.864 3.957-1.766-1.777.045-6.217 3.612-9.75l.003-.003z"/>
    </svg>
    <span class="badge-label">Ruby:</span>
    <span class="badge-value">{min_ruby_version}</span>
    <span class="badge-subtext">(Rec. 3.3+)</span>
  </div>

  <!-- Actions Count Badge -->
  <a
    href="/fastlane-handbook/actions/upload_to_play_store/"
    class="badge-pill badge-actions"
    title="Introspected directly from Fastlane Gem AST"
  >
    <svg
      class="badge-icon-svg actions-icon"
      viewBox="0 0 24 24"
      width="15"
      height="15"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
    </svg>
    <span class="badge-label">Actions:</span>
    <span class="badge-value">{active_actions} Active</span>
    <span class="badge-subtext">({total_actions} Total)</span>
  </a>

  <!-- RubyGems Badge -->
  <a
    href={rubygems_url}
    target="_blank"
    rel="noopener noreferrer"
    class="badge-pill badge-rubygems"
    title="View Fastlane on RubyGems"
  >
    <svg
      class="badge-icon-svg rubygems-icon"
      viewBox="0 0 24 24"
      width="15"
      height="15"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12 2L2 7.5v9L12 22l10-5.5v-9L12 2zm0 2.2l7.6 4.2-3.3 1.8-7.6-4.2L12 4.2zM4.4 8.7L11 12.3v7.3l-6.6-3.6V8.7zm8.6 7.3v-7.3l6.6-3.6v7.3l-6.6 3.6z"/>
    </svg>
    <span class="badge-label">RubyGems:</span>
    <span class="badge-value status-stable">stable</span>
  </a>
</div>

<style>
  .version-badge-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin: 1.25rem 0 2rem 0;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-hairline-light);
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    line-height: 1.2;
    text-decoration: none;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-text);
    transition: transform 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .badge-pill:hover {
    transform: translateY(-1px);
    border-color: var(--sl-color-hairline-light);
    text-decoration: none;
  }

  /* Fastlane Badge Specifics */
  .badge-fastlane {
    border-color: rgba(56, 189, 248, 0.3);
    background: rgba(56, 189, 248, 0.08);
  }
  .badge-fastlane:hover {
    border-color: rgba(56, 189, 248, 0.6);
  }
  .fastlane-logo {
    color: #38bdf8;
    flex-shrink: 0;
  }
  .badge-fastlane .badge-value {
    color: #38bdf8;
    font-weight: 700;
  }

  /* Ruby Badge Specifics */
  .badge-ruby {
    border-color: rgba(239, 68, 68, 0.3);
    background: rgba(239, 68, 68, 0.08);
  }
  .ruby-logo {
    color: #ef4444;
    flex-shrink: 0;
  }
  .badge-ruby .badge-value {
    color: #f87171;
    font-weight: 700;
  }

  /* Actions Badge Specifics */
  .badge-actions {
    border-color: rgba(234, 179, 8, 0.3);
    background: rgba(234, 179, 8, 0.08);
  }
  .badge-actions:hover {
    border-color: rgba(234, 179, 8, 0.6);
  }
  .actions-icon {
    color: #eab308;
    flex-shrink: 0;
  }
  .badge-actions .badge-value {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  /* RubyGems Badge Specifics */
  .badge-rubygems {
    border-color: rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.08);
  }
  .badge-rubygems:hover {
    border-color: rgba(16, 185, 129, 0.6);
  }
  .rubygems-icon {
    color: #10b981;
    flex-shrink: 0;
  }
  .status-stable {
    color: #10b981;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .badge-icon-svg {
    display: inline-block;
    vertical-align: middle;
  }

  .badge-label {
    opacity: 0.88;
    font-weight: 500;
    color: var(--sl-color-gray-2);
  }

  .badge-subtext {
    font-size: 0.72rem;
    opacity: 0.78;
    color: var(--sl-color-gray-3);
  }

  @media (max-width: 640px) {
    .version-badge-strip {
      padding: 0.625rem;
      gap: 0.5rem;
    }
    .badge-pill {
      font-size: 0.75rem;
      padding: 0.25rem 0.55rem;
    }
  }
</style>
